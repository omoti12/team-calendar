rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 合言葉のハッシュ（64文字）ごとのチームの現場データ。
    // チームの一覧は取得できないので、合言葉を知っている人だけが読み書きできる
    match /teams/{team}/sites/{site} {
      allow read, delete: if team.size() == 64;
      allow create, update: if team.size() == 64
        && request.resource.data.id == site
        && request.resource.data.tasks is list
        && request.resource.data.tasks.size() <= 300;
    }
  }
}
